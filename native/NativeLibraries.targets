<Project>
  <PropertyGroup>
    <NativeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</NativeRoot>
    <UnixPtyRid Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">$(RuntimeIdentifier)</UnixPtyRid>
    <UnixPtyRid Condition="'$(UnixPtyRid)' == '' and '$(RuntimeIdentifier)' == '' and ($([System.String]::Copy('$(NETCoreSdkPortableRuntimeIdentifier)').StartsWith('linux-')) or $([System.String]::Copy('$(NETCoreSdkPortableRuntimeIdentifier)').StartsWith('osx-')))">$(NETCoreSdkPortableRuntimeIdentifier)</UnixPtyRid>
    <NativeRestore Condition="'$(NativeRestore)' == ''">pty</NativeRestore>
    <NativeRestoreShell Condition="$([MSBuild]::IsOSPlatform('Windows'))">powershell.exe</NativeRestoreShell>
    <NativeRestoreShell Condition="$([MSBuild]::IsOSPlatform('Linux'))">pwsh</NativeRestoreShell>
    <NativeRestoreShell Condition="$([MSBuild]::IsOSPlatform('OSX'))">pwsh</NativeRestoreShell>
  </PropertyGroup>

  <!-- dt-pty-host is the only native helper built from source; Windows RIDs have nothing to restore. -->
  <Target Name="RestoreNativeLibraries"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipNativeRestore)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(NativeRestore)' != 'none' and '$(UnixPtyRid)' != ''">
    <Exec
      Command="$(NativeRestoreShell) -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(NativeRoot)Restore-NativeLibraries.ps1&quot; -Rid $(UnixPtyRid)"
      LogStandardErrorAsError="false" />
  </Target>

  <Target Name="CopyRestoredNativeLibraries"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(NativeRestore)' != 'none' and '$(UnixPtyRid)' != ''">
    <Copy
      SourceFiles="$(NativeRoot)linux-pty\$(UnixPtyRid)\dt-pty-host"
      DestinationFiles="$(TargetDir)dt-pty-host"
      SkipUnchangedFiles="true"
      Condition="Exists('$(NativeRoot)linux-pty\$(UnixPtyRid)\dt-pty-host')" />
    <Exec
      Command="chmod +x &quot;$(TargetDir)dt-pty-host&quot;"
      Condition="Exists('$(TargetDir)dt-pty-host') and !$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

  <Target Name="PublishRestoredNativeLibraries"
          AfterTargets="Publish"
          Condition="'$(NativeRestore)' != 'none' and '$(PublishDir)' != '' and '$(UnixPtyRid)' != ''">
    <Copy
      SourceFiles="$(NativeRoot)linux-pty\$(UnixPtyRid)\dt-pty-host"
      DestinationFiles="$(PublishDir)dt-pty-host"
      SkipUnchangedFiles="true"
      Condition="Exists('$(NativeRoot)linux-pty\$(UnixPtyRid)\dt-pty-host')" />
    <Exec
      Command="chmod +x &quot;$(PublishDir)dt-pty-host&quot;"
      Condition="Exists('$(PublishDir)dt-pty-host') and !$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>
</Project>
