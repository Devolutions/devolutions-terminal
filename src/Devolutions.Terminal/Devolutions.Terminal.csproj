<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Devolutions.Terminal</RootNamespace>
    <ApplicationIcon>$(DevolutionsTerminalWindowsIcon)</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishAot Condition="'$(Configuration)' == 'Debug'">false</PublishAot>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <DebugType>embedded</DebugType>
    <AssemblyName>Devolutions.Terminal</AssemblyName>
    <Product>Devolutions Terminal</Product>
    <Description>Avalonia terminal emulator with an embedded PowerShell ISE workbench.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <None Include="..\..\native\ghostty\LICENSE"
          Link="THIRD-PARTY-NOTICES-GHOSTTY.txt"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\native\noto-emoji\LICENSE"
          Link="THIRD-PARTY-NOTICES-NOTO-EMOJI.txt"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\..\native\NativeLibraries.targets" />

  <Target Name="KeepNativePayloadSignable" BeforeTargets="_ComputeFilesToBundle"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                            Condition="'%(ResolvedFileToPublish.AssetType)' == 'native' or '%(ResolvedFileToPublish.Filename)' == 'OpenConsole' or ('%(ResolvedFileToPublish.Filename)' == 'dt' and '%(ResolvedFileToPublish.Extension)' == '.exe') or '%(ResolvedFileToPublish.Filename)' == 'dt-pty-host' or '%(ResolvedFileToPublish.Filename)' == 'ghostty-vt' or '%(ResolvedFileToPublish.Filename)' == 'libghostty-vt'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="ValidateInstalledPowerShellBoundary" BeforeTargets="_ComputeFilesToBundle;CopyFilesToPublishDirectory"
          Condition="'$(EnablePowerShellIse)' == 'true'">
    <ItemGroup>
      <_ForbiddenPowerShellPayload Include="@(ResolvedFileToPublish)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.Filename)', '(?i)^(System\.Management\.Automation|Microsoft\.PowerShell\.|PowerShell\.|Microsoft\.Management\.Infrastructure|pwsh$)'))" />
      <_ForbiddenPowerShellPayload Include="@(ResolvedFileToPublish)"
          Condition="'$(PublishAot)' == 'true' and $([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.Filename)', '(?i)^(lib)?(coreclr|hostfxr|hostpolicy|clrjit|mscordaccore)$'))" />
      <_IsebergBridgeModule Include="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Iseberg.PowerShell.dll' and $([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '(^|[\\/])Iseberg\.PowerShell[\\/]'))" />
      <_UnexpectedIsebergBridgePayload Include="@(ResolvedFileToPublish)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '(^|[\\/])Iseberg\.PowerShell[\\/]')) and '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' != 'Iseberg.PowerShell.dll'" />
    </ItemGroup>
    <Error Condition="'@(_ForbiddenPowerShellPayload)' != ''"
           Text="Iseberg must load the separately installed PowerShell runtime, not redistribute SDK runtime assets: @(_ForbiddenPowerShellPayload)" />
    <Error Condition="'@(_UnexpectedIsebergBridgePayload)' != ''"
           Text="The Iseberg bridge payload must contain only Iseberg.PowerShell.dll: @(_UnexpectedIsebergBridgePayload)" />
    <Error Condition="'@(_IsebergBridgeModule)' == ''"
           Text="The Iseberg publish must include Iseberg.PowerShell.dll as loose content in the Iseberg.PowerShell directory." />
  </Target>

  <Target Name="PublishDtCli" AfterTargets="Publish">
    <PropertyGroup>
      <_HostPublishDir Condition="$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$(PublishDir)</_HostPublishDir>
      <_HostPublishDir Condition="!$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(PublishDir)'))</_HostPublishDir>
    </PropertyGroup>
    <MSBuild
      Projects="..\Devolutions.Terminal.Cli\Devolutions.Terminal.Cli.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishAot=true;PublishTrimmed=true;PublishDir=$(_HostPublishDir)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Devolutions.Terminal.App\Devolutions.Terminal.App.csproj" />
    <ProjectReference Include="..\Devolutions.Terminal.Broker\Devolutions.Terminal.Broker.csproj" />
    <ProjectReference Include="..\Devolutions.Terminal.Cli\Devolutions.Terminal.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\..\assets\icons\terminal.ico" Link="Assets\terminal.ico" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="Devolutions.Terminal" />
    <TrimmerRootAssembly Include="Devolutions.Terminal.App" />
    <TrimmerRootAssembly Include="Devolutions.Terminal.Settings.Editor" />
  </ItemGroup>
</Project>
