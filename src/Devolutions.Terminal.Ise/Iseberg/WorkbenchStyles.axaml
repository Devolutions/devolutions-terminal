<Styles xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="using:Iseberg.Editor"
             xmlns:local="using:Iseberg"
             x:Class="Iseberg.WorkbenchStyles">
    <FluentTheme />
    <editor:EditorStyles />
    <Style Selector="local|WorkbenchControl">
      <Setter Property="FontFamily" Value="{DynamicResource DesktopFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource DesktopFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}" />
    </Style>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{DynamicResource DesktopFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource DesktopFontSize}" />
      <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Button.tool:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.close">
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="MinHeight" Value="20" />
    </Style>
    <Style Selector="TabStripItem">
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontFamily" Value="{DynamicResource DesktopFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource DesktopFontSize}" />
      <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style Selector="TabStripItem:selected">
      <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
    </Style>
    <Style Selector="Menu">
      <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style Selector="Menu#WorkbenchMenu > MenuItem">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Styles.Resources>
      <ControlTheme x:Key="CompactZoomTheme" TargetType="Slider">
       <Setter Property="Focusable" Value="True" />
       <Setter Property="Template">
        <ControlTemplate>
          <Track x:Name="PART_Track" Height="20" VerticalAlignment="Center"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="Horizontal"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton x:Name="PART_DecreaseButton" Focusable="False">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Height="2" VerticalAlignment="Center" Background="{DynamicResource SelectionBrush}" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton x:Name="PART_IncreaseButton" Focusable="False">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Height="2" VerticalAlignment="Center" Background="{DynamicResource DisabledTextBrush}" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseButton>
            <Track.Thumb>
              <Thumb Width="14" Height="14" MinWidth="14" MinHeight="14">
                <Thumb.Template>
                  <ControlTemplate>
                    <Border CornerRadius="7" Background="{DynamicResource SelectionBrush}" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
       </Setter>
      </ControlTheme>
    </Styles.Resources>
    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionTextBrush}" />
    </Style>
</Styles>
