<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Devolutions.Terminal.Connection</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>ConPTY, Unix PTY, Azure Cloud Shell, and browser WASM connections.</Description>
    <!-- Not published standalone; bundled into the Devolutions.Terminal.Control NuGet package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" GeneratePathProperty="true" ExcludeAssets="build" />
    <ProjectReference Include="..\Devolutions.Terminal.Core\Devolutions.Terminal.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <ConPtyHostSourceRoot>$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes</ConPtyHostSourceRoot>
  </PropertyGroup>
  <Import Project="ConPtyHost.targets" />
</Project>
