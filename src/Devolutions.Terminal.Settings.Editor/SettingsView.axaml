<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Devolutions.Terminal.Settings.Editor"
        xmlns:controls="using:Devolutions.Terminal.Settings.Editor.Controls"
        x:Class="Devolutions.Terminal.Settings.Editor.SettingsView"
        x:DataType="vm:SettingsEditorViewModel"
        x:CompileBindings="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Classes="settings-view"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
  <UserControl.Styles>
    <StyleInclude Source="avares://Devolutions.Terminal.Settings.Editor/SettingsTheme.axaml" />
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,11" />
    </Style>
    <Style Selector="TextBlock.pageDescription">
      <Setter Property="Opacity" Value="0.72" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,20" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,16,6" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="MinWidth" Value="200" />
    </Style>
    <Style Selector="ComboBox.field">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="MinWidth" Value="200" />
    </Style>
    <Style Selector="CheckBox.field">
      <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style Selector="TextBox.jsonEditor">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="MinHeight" Value="180" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="ToggleButton.navigationMenu">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:StartupSettingsViewModel}" x:DataType="vm:StartupSettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <controls:SettingsRow Header="Default profile"
                              Description="Profile that opens when clicking the '+' icon or using the new tab key binding.">
          <controls:SettingsRow.Value>
            <ComboBox Classes="field"
                      ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Launch mode"
                              Description="Choose how new terminal windows are displayed.">
          <controls:SettingsRow.Value>
            <ComboBox Classes="field" ItemsSource="{Binding LaunchModes}" SelectedItem="{Binding LaunchMode}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Center on launch"
                              Description="Center newly created windows on the selected display.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Center on launch" IsChecked="{Binding CenterOnLaunch}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Always on top"
                              Description="Keep terminal windows above other windows.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Always on top" IsChecked="{Binding AlwaysOnTop}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Automatically hide window"
                              Description="Hide the window when it loses focus.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Automatically hide window" IsChecked="{Binding AutoHideWindow}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Launch size"
                              Description="The number of rows and columns displayed in a new window.">
          <controls:SettingsRow.Value>
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
              <TextBox AutomationProperties.Name="Initial columns"
                       Text="{Binding InitialColumns}"
                       HorizontalContentAlignment="Right" />
              <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" />
              <TextBox Grid.Column="2"
                       AutomationProperties.Name="Initial rows"
                       Text="{Binding InitialRows}"
                       HorizontalContentAlignment="Right" />
            </Grid>
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <Border Classes="settings-card">
          <Expander Classes="settings-expander"
                    Header="Launch parameters"
                    HorizontalAlignment="Stretch">
            <StackPanel Margin="0,8,0,0">
            <controls:SettingsRow Header="Initial position"
                                  Description="Optional X,Y desktop coordinates for the first window.">
              <controls:SettingsRow.Value>
                <TextBox Classes="field" Text="{Binding InitialPosition}" />
              </controls:SettingsRow.Value>
            </controls:SettingsRow>
            <controls:SettingsRow Header="First window preference"
                                  Description="Controls how the first terminal window is selected.">
              <controls:SettingsRow.Value>
                <ComboBox Classes="field"
                          ItemsSource="{Binding FirstWindowPreferenceChoices}"
                          SelectedItem="{Binding FirstWindowPreference}" />
              </controls:SettingsRow.Value>
            </controls:SettingsRow>
            <controls:SettingsRow Header="Windowing behavior"
                                  Description="Controls whether commands reuse or create windows.">
              <controls:SettingsRow.Value>
                <ComboBox Classes="field"
                          ItemsSource="{Binding WindowingBehaviorChoices}"
                          SelectedItem="{Binding WindowingBehavior}" />
              </controls:SettingsRow.Value>
            </controls:SettingsRow>
            <controls:SettingsRow Header="Startup actions"
                                  Description="Commands executed when the terminal starts.">
              <controls:SettingsRow.Value>
                <TextBox Classes="field" Text="{Binding StartupActions}" />
              </controls:SettingsRow.Value>
            </controls:SettingsRow>
            </StackPanel>
          </Expander>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:InteractionSettingsViewModel}" x:DataType="vm:InteractionSettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <controls:SettingsRow Header="Copy on select"
                              Description="Automatically copy selected text to the clipboard.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Copy on select" IsChecked="{Binding CopyOnSelect}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Copy formatting"
                              Description="Copy selected text as HTML and RTF in addition to plain text.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Copy formatting" IsChecked="{Binding CopyFormatting}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Trim rectangular selection"
                              Description="Remove trailing whitespace from rectangular selections.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Trim rectangular selection" IsChecked="{Binding TrimBlockSelection}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Trim pasted text"
                              Description="Remove leading, trailing, and repeated whitespace from pasted text.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Trim pasted text" IsChecked="{Binding TrimPaste}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Focus follows mouse"
                              Description="Focus the pane under the mouse pointer without clicking.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Focus follows mouse" IsChecked="{Binding FocusFollowMouse}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Scroll wheel zooms with Ctrl"
                              Description="Hold Ctrl and scroll to zoom the terminal text.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Scroll wheel zooms with Ctrl" IsChecked="{Binding ScrollToZoom}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Scroll wheel changes opacity"
                              Description="Hold Ctrl and scroll to change the window opacity.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Scroll wheel changes opacity" IsChecked="{Binding ScrollToChangeOpacity}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Detect URLs"
                              Description="Highlight and open hyperlinks inside the terminal.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Detect URLs" IsChecked="{Binding DetectUrls}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Warn about large paste"
                              Description="Ask for confirmation before pasting a large amount of text.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Warn about large paste" IsChecked="{Binding WarnAboutLargePaste}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Multi-line paste warning"
                              Description="Choose when to warn about pasting text that spans multiple lines.">
          <controls:SettingsRow.Value>
            <ComboBox Classes="field"
                      ItemsSource="{Binding WarnAboutMultiLinePasteChoices}"
                      SelectedItem="{Binding WarnAboutMultiLinePaste}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Word delimiters"
                              Description="Characters used to determine the boundaries of a word when double-clicking.">
          <controls:SettingsRow.Value>
            <TextBox Classes="field" Text="{Binding WordDelimiters}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AppearanceSettingsViewModel}" x:DataType="vm:AppearanceSettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <controls:SettingsRow Header="Dark theme"
                              Description="Color scheme used when the system is in dark mode.">
          <controls:SettingsRow.Value>
            <TextBox Classes="field" Text="{Binding DarkTheme}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Light theme"
                              Description="Color scheme used when the system is in light mode.">
          <controls:SettingsRow.Value>
            <TextBox Classes="field" Text="{Binding LightTheme}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Tab width mode"
                              Description="Control how terminal tabs shrink when space runs out.">
          <controls:SettingsRow.Value>
            <ComboBox Classes="field"
                      ItemsSource="{Binding TabWidthModes}"
                      SelectedItem="{Binding TabWidthMode}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="New tab position"
                              Description="Where new tabs appear in the tab row.">
          <controls:SettingsRow.Value>
            <ComboBox Classes="field"
                      ItemsSource="{Binding NewTabPositionChoices}"
                      SelectedItem="{Binding NewTabPosition}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Always show tabs"
                              Description="Keep the tab row visible even when a single tab is open.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Always show tabs" IsChecked="{Binding AlwaysShowTabs}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Tabs in title bar"
                              Description="Render the tab row inside the window title bar.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Tabs in title bar" IsChecked="{Binding ShowTabsInTitlebar}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Terminal title in title bar"
                              Description="Show the active terminal title as the window title.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Terminal title in title bar" IsChecked="{Binding ShowTerminalTitleInTitlebar}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Tabs in fullscreen"
                              Description="Keep the tab row visible while in full screen mode.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Tabs in fullscreen" IsChecked="{Binding ShowTabsFullscreen}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Acrylic tab row"
                              Description="Use acrylic material behind the tab row.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Acrylic tab row" IsChecked="{Binding UseAcrylicInTabRow}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Disable animations"
                              Description="Turn off window and pane animation effects.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Disable animations" IsChecked="{Binding DisableAnimations}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <TextBlock Classes="sectionTitle" Text="Theme details" />
        <ComboBox Classes="field" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
        <Border Classes="settings-card">
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="fieldLabel" Text="Window application theme" />
          <TextBox Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding SelectedTheme.WindowApplicationTheme}" />
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Tab icon style" />
          <TextBox Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding SelectedTheme.TabIconStyle}" />
          <CheckBox Grid.Row="2" Grid.Column="1" Classes="field" Content="Use Mica" IsChecked="{Binding SelectedTheme.UseMica}" />
          <CheckBox Grid.Row="3" Grid.Column="1" Classes="field" Content="Rainbow frame" IsChecked="{Binding SelectedTheme.RainbowFrame}" />
          </Grid>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProfilesSettingsViewModel}" x:DataType="vm:ProfilesSettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding SelectedProfile.Name}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <controls:SettingsRow Header="Profile"
                              Description="Choose the profile to edit.">
          <controls:SettingsRow.Value>
            <ComboBox Classes="field" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Name"
                              Description="The name of the profile that appears in the dropdown.">
          <controls:SettingsRow.Value>
            <TextBox Classes="field" Text="{Binding SelectedProfile.Name}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Command line"
                              Description="Executable used when this profile starts.">
          <controls:SettingsRow.Value>
            <TextBox Classes="field" Text="{Binding SelectedProfile.Commandline}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Starting directory"
                              Description="The directory this profile starts in when loaded.">
          <controls:SettingsRow.Value>
            <TextBox Classes="field" Text="{Binding SelectedProfile.StartingDirectory}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Icon"
                              Description="Emoji or image location used for this profile.">
          <controls:SettingsRow.Value>
            <TextBox Classes="field" Text="{Binding SelectedProfile.Icon}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Tab title"
                              Description="Overrides the profile name shown in the tab.">
          <controls:SettingsRow.Value>
            <TextBox Classes="field" Text="{Binding SelectedProfile.TabTitle}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Tab color"
                              Description="Optional color used for the profile tab.">
          <controls:SettingsRow.Value>
            <TextBox Classes="field" Text="{Binding SelectedProfile.TabColor}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Run this profile as Administrator"
                              Description="Open this profile in an elevated terminal window.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle IsChecked="{Binding SelectedProfile.Elevate}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Hide profile from dropdown"
                              Description="Keep this profile in settings without showing it in the new-tab menu.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle IsChecked="{Binding SelectedProfile.Hidden}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <TextBlock Classes="sectionTitle" Text="Profile details" />
        <controls:SettingsRow Header="GUID"
                              Description="Stable identity used to reference this profile.">
          <controls:SettingsRow.Value>
            <TextBox Classes="field" IsReadOnly="True" Text="{Binding SelectedProfile.Guid}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Source"
                              Description="Dynamic profile generator or settings layer that owns this profile.">
          <controls:SettingsRow.Value>
            <TextBox Classes="field" IsReadOnly="True" Text="{Binding SelectedProfile.Source}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Suppress application title"
                              Description="Keep the configured tab title instead of the shell-provided title.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle IsChecked="{Binding SelectedProfile.SuppressApplicationTitle}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProfileAppearanceSettingsViewModel}" x:DataType="vm:ProfileAppearanceSettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <ComboBox Classes="field" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
        <Border Classes="settings-card">
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="fieldLabel" Text="Font face" />
          <TextBox Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.FontFace}" />
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Font size" />
          <TextBox Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.FontSize}" />
          <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Font weight" />
          <TextBox Grid.Row="2" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.FontWeight}" />
          <TextBlock Grid.Row="3" Classes="fieldLabel" Text="Dark color scheme" />
          <TextBox Grid.Row="3" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.DarkColorScheme}" />
          <TextBlock Grid.Row="4" Classes="fieldLabel" Text="Light color scheme" />
          <TextBox Grid.Row="4" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.LightColorScheme}" />
          <TextBlock Grid.Row="5" Classes="fieldLabel" Text="Foreground" />
          <TextBox Grid.Row="5" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.Foreground}" />
          <TextBlock Grid.Row="6" Classes="fieldLabel" Text="Background" />
          <TextBox Grid.Row="6" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.Background}" />
          <TextBlock Grid.Row="7" Classes="fieldLabel" Text="Cursor color" />
          <TextBox Grid.Row="7" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.CursorColor}" />
          <TextBlock Grid.Row="8" Classes="fieldLabel" Text="Selection background" />
          <TextBox Grid.Row="8" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.SelectionBackground}" />
          <TextBlock Grid.Row="9" Classes="fieldLabel" Text="Opacity (0-100)" />
          <TextBox Grid.Row="9" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.Opacity}" />
          <TextBlock Grid.Row="10" Classes="fieldLabel" Text="Background image" />
          <TextBox Grid.Row="10" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.BackgroundImage}" />
          <TextBlock Grid.Row="11" Classes="fieldLabel" Text="Background image opacity" />
          <TextBox Grid.Row="11" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.BackgroundImageOpacity}" />
          </Grid>
        </Border>
        <controls:SettingsRow Header="Use acrylic"
                              Description="Use acrylic material for the terminal background.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Use acrylic" IsChecked="{Binding SelectedProfile.UseAcrylic}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Retro terminal effect"
                              Description="Add scan lines and glowing text for a CRT look.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Retro terminal effect" IsChecked="{Binding SelectedProfile.RetroTerminalEffect}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProfileTerminalSettingsViewModel}" x:DataType="vm:ProfileTerminalSettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <ComboBox Classes="field" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
        <Border Classes="settings-card">
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="fieldLabel" Text="History size" />
          <TextBox Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.HistorySize}" />
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Padding" />
          <TextBox Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.Padding}" />
          <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Cursor shape" />
          <ComboBox Grid.Row="2" Grid.Column="1" Classes="field"
                    ItemsSource="{Binding CursorShapeChoices}" SelectedItem="{Binding SelectedProfile.CursorShape}" />
          <TextBlock Grid.Row="3" Classes="fieldLabel" Text="Cursor height" />
          <TextBox Grid.Row="3" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.CursorHeight}" />
          <TextBlock Grid.Row="4" Classes="fieldLabel" Text="Close on exit" />
          <ComboBox Grid.Row="4" Grid.Column="1" Classes="field"
                    ItemsSource="{Binding CloseOnExitModes}" SelectedItem="{Binding SelectedProfile.CloseOnExit}" />
          </Grid>
        </Border>
        <controls:SettingsRow Header="Scrollbar visibility"
                              Description="Show, hide, or keep the scrollbar until scrolling starts.">
          <controls:SettingsRow.Value>
            <ComboBox Classes="field"
                      ItemsSource="{Binding ScrollbarStateChoices}"
                      SelectedItem="{Binding SelectedProfile.ScrollbarState}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Snap on input"
                              Description="Scroll to the bottom when typing.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Snap on input" IsChecked="{Binding SelectedProfile.SnapOnInput}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="AltGr aliasing"
                              Description="Treat Ctrl+Alt as AltGr for international keyboards.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="AltGr aliasing" IsChecked="{Binding SelectedProfile.AltGrAliasing}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Right-click context menu"
                              Description="Show the context menu when right-clicking the terminal.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Right-click context menu" IsChecked="{Binding SelectedProfile.RightClickContextMenu}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Auto-mark prompts"
                              Description="Automatically mark prompt lines for navigation.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Auto-mark prompts" IsChecked="{Binding SelectedProfile.AutoMarkPrompts}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Show marks on scrollbar"
                              Description="Show prompt marks as ticks on the scrollbar.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Show marks on scrollbar" IsChecked="{Binding SelectedProfile.ShowMarksOnScrollbar}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProfileAdvancedSettingsViewModel}" x:DataType="vm:ProfileAdvancedSettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <ComboBox Classes="field" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
        <controls:SettingsRow Header="Reload environment variables"
                              Description="Refresh the environment block when a new terminal starts.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Reload environment variables" IsChecked="{Binding SelectedProfile.ReloadEnvironmentVariables}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Force VT input"
                              Description="Always send input as VT sequences instead of Windows messages.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Force VT input" IsChecked="{Binding SelectedProfile.ForceVtInput}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Allow Kitty keyboard mode"
                              Description="Permit the Kitty keyboard protocol for advanced key events.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Allow Kitty keyboard mode" IsChecked="{Binding SelectedProfile.AllowKittyKeyboardMode}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Allow OSC 52 clipboard"
                              Description="Let applications write to the clipboard using OSC 52.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Allow OSC 52 clipboard" IsChecked="{Binding SelectedProfile.AllowVtClipboardWrite}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Allow OSC notifications"
                              Description="Let applications raise toast notifications using OSC 9.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Allow OSC notifications" IsChecked="{Binding SelectedProfile.AllowOscNotifications}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <Border Classes="settings-card">
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="fieldLabel" Text="Terminal emulation engine" />
          <ComboBox Grid.Row="0"
                    Grid.Column="1"
                    Classes="field"
                    ItemsSource="{x:Static vm:ProfileItemViewModel.TerminalEngineChoices}"
                    SelectedItem="{Binding SelectedProfile.TerminalEngine}" />
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Drag/drop delimiter" />
          <TextBox Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.DragDropDelimiter}" />
          <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Path translation style" />
          <TextBox Grid.Row="2" Grid.Column="1" Classes="field" Text="{Binding SelectedProfile.PathTranslationStyle}" />
          </Grid>
        </Border>
        <TextBlock Margin="0,16,0,6" FontSize="18" FontWeight="SemiBold" Text="Environment JSON" />
        <TextBlock Opacity="0.7" Text="Values must be strings or null. JSON is validated before Apply." />
        <TextBox Classes="jsonEditor" Text="{Binding SelectedProfile.EnvironmentJson}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ColorSchemesSettingsViewModel}" x:DataType="vm:ColorSchemesSettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <ComboBox Classes="field" ItemsSource="{Binding Schemes}" SelectedItem="{Binding SelectedScheme}" />
        <Border Classes="settings-card">
          <Grid ColumnDefinitions="160,*,160,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="fieldLabel" Text="Name" />
          <TextBox Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding SelectedScheme.Name}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Classes="fieldLabel" Text="Foreground" />
          <TextBox Grid.Row="0" Grid.Column="3" Classes="field" Text="{Binding SelectedScheme.Foreground}" />
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Background" />
          <TextBox Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding SelectedScheme.Background}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Classes="fieldLabel" Text="Cursor" />
          <TextBox Grid.Row="1" Grid.Column="3" Classes="field" Text="{Binding SelectedScheme.CursorColor}" />
          <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Selection" />
          <TextBox Grid.Row="2" Grid.Column="1" Classes="field" Text="{Binding SelectedScheme.SelectionBackground}" />
          <TextBlock Grid.Row="3" Classes="fieldLabel" Text="Black" />
          <TextBox Grid.Row="3" Grid.Column="1" Classes="field" Text="{Binding SelectedScheme.Black}" />
          <TextBlock Grid.Row="3" Grid.Column="2" Classes="fieldLabel" Text="Bright black" />
          <TextBox Grid.Row="3" Grid.Column="3" Classes="field" Text="{Binding SelectedScheme.BrightBlack}" />
          <TextBlock Grid.Row="4" Classes="fieldLabel" Text="Red" />
          <TextBox Grid.Row="4" Grid.Column="1" Classes="field" Text="{Binding SelectedScheme.Red}" />
          <TextBlock Grid.Row="4" Grid.Column="2" Classes="fieldLabel" Text="Bright red" />
          <TextBox Grid.Row="4" Grid.Column="3" Classes="field" Text="{Binding SelectedScheme.BrightRed}" />
          <TextBlock Grid.Row="5" Classes="fieldLabel" Text="Green" />
          <TextBox Grid.Row="5" Grid.Column="1" Classes="field" Text="{Binding SelectedScheme.Green}" />
          <TextBlock Grid.Row="5" Grid.Column="2" Classes="fieldLabel" Text="Bright green" />
          <TextBox Grid.Row="5" Grid.Column="3" Classes="field" Text="{Binding SelectedScheme.BrightGreen}" />
          <TextBlock Grid.Row="6" Classes="fieldLabel" Text="Yellow" />
          <TextBox Grid.Row="6" Grid.Column="1" Classes="field" Text="{Binding SelectedScheme.Yellow}" />
          <TextBlock Grid.Row="6" Grid.Column="2" Classes="fieldLabel" Text="Bright yellow" />
          <TextBox Grid.Row="6" Grid.Column="3" Classes="field" Text="{Binding SelectedScheme.BrightYellow}" />
          <TextBlock Grid.Row="7" Classes="fieldLabel" Text="Blue" />
          <TextBox Grid.Row="7" Grid.Column="1" Classes="field" Text="{Binding SelectedScheme.Blue}" />
          <TextBlock Grid.Row="7" Grid.Column="2" Classes="fieldLabel" Text="Bright blue" />
          <TextBox Grid.Row="7" Grid.Column="3" Classes="field" Text="{Binding SelectedScheme.BrightBlue}" />
          <TextBlock Grid.Row="8" Classes="fieldLabel" Text="Purple" />
          <TextBox Grid.Row="8" Grid.Column="1" Classes="field" Text="{Binding SelectedScheme.Purple}" />
          <TextBlock Grid.Row="8" Grid.Column="2" Classes="fieldLabel" Text="Bright purple" />
          <TextBox Grid.Row="8" Grid.Column="3" Classes="field" Text="{Binding SelectedScheme.BrightPurple}" />
          <TextBlock Grid.Row="9" Classes="fieldLabel" Text="Cyan" />
          <TextBox Grid.Row="9" Grid.Column="1" Classes="field" Text="{Binding SelectedScheme.Cyan}" />
          <TextBlock Grid.Row="9" Grid.Column="2" Classes="fieldLabel" Text="Bright cyan" />
          <TextBox Grid.Row="9" Grid.Column="3" Classes="field" Text="{Binding SelectedScheme.BrightCyan}" />
          <TextBlock Grid.Row="10" Classes="fieldLabel" Text="White" />
          <TextBox Grid.Row="10" Grid.Column="1" Classes="field" Text="{Binding SelectedScheme.White}" />
          <TextBlock Grid.Row="10" Grid.Column="2" Classes="fieldLabel" Text="Bright white" />
          <TextBox Grid.Row="10" Grid.Column="3" Classes="field" Text="{Binding SelectedScheme.BrightWhite}" />
          </Grid>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ActionsSettingsViewModel}" x:DataType="vm:ActionsSettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Key chord display" />
        <ItemsControl ItemsSource="{Binding Bindings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ActionBindingSummary">
              <Grid ColumnDefinitions="220,*,100" Margin="0,3">
                <TextBlock Text="{Binding Chord}" FontFamily="Cascadia Mono, Consolas" />
                <TextBlock Grid.Column="1" Text="{Binding Action}" />
                <TextBlock Grid.Column="2" Text="{Binding Source}" Opacity="0.65" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,16,0,6" FontSize="18" FontWeight="SemiBold" Text="Actions JSON" />
        <TextBox Classes="jsonEditor" Text="{Binding ActionsJson}" />
        <TextBlock Margin="0,16,0,6" FontSize="18" FontWeight="SemiBold" Text="Keybindings JSON" />
        <TextBox Classes="jsonEditor" Text="{Binding KeybindingsJson}" />
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
          <Button Content="Validate JSON" Command="{Binding ValidateCommand}" />
          <TextBlock VerticalAlignment="Center" Text="{Binding ValidationMessage}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NewTabMenuSettingsViewModel}" x:DataType="vm:NewTabMenuSettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <TextBlock TextWrapping="Wrap"
                   Text="Recognized entries preserve extra properties. Unsupported entry types are rejected instead of being dropped." />
        <TextBox Margin="0,12,0,0" MinHeight="420" Classes="jsonEditor" Text="{Binding Json}" />
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
          <Button Content="Validate JSON" Command="{Binding ValidateCommand}" />
          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ValidationMessage}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:RenderingSettingsViewModel}" x:DataType="vm:RenderingSettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <Border Classes="settings-card">
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Classes="fieldLabel" Text="Terminal emulation engine" />
          <ComboBox Grid.Row="0"
                    Grid.Column="1"
                    Classes="field"
                    ItemsSource="{Binding TerminalEngines}"
                    SelectedItem="{Binding TerminalEngine}" />
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Graphics API" />
          <ComboBox Grid.Row="1"
                    Grid.Column="1"
                    Classes="field"
                    ItemsSource="{Binding GraphicsApiChoices}"
                    SelectedItem="{Binding GraphicsApi}" />
          </Grid>
        </Border>
        <controls:SettingsRow Header="Disable partial invalidation"
                              Description="Redraw the whole terminal surface on every update.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Disable partial invalidation" IsChecked="{Binding DisablePartialInvalidation}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Software rendering"
                              Description="Force CPU rendering instead of the GPU.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Software rendering" IsChecked="{Binding SoftwareRendering}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Use background image for window"
                              Description="Extend the terminal background image to the whole window.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Use background image for window" IsChecked="{Binding UseBackgroundImageForWindow}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CompatibilitySettingsViewModel}" x:DataType="vm:CompatibilitySettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <Border Classes="settings-card">
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="fieldLabel" Text="Text measurement" />
          <ComboBox Grid.Row="0"
                    Grid.Column="1"
                    Classes="field"
                    ItemsSource="{Binding TextMeasurementChoices}"
                    SelectedItem="{Binding TextMeasurement}" />
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Ambiguous character width" />
          <ComboBox Grid.Row="1"
                    Grid.Column="1"
                    Classes="field"
                    ItemsSource="{Binding AmbiguousWidthChoices}"
                    SelectedItem="{Binding AmbiguousWidth}" />
          <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Default input scope" />
          <ComboBox Grid.Row="2"
                    Grid.Column="1"
                    Classes="field"
                    ItemsSource="{Binding DefaultInputScopeChoices}"
                    SelectedItem="{Binding DefaultInputScope}" />
          </Grid>
        </Border>
        <controls:SettingsRow Header="Allow headless operation"
                              Description="Run terminal sessions without a visible window.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Allow headless operation" IsChecked="{Binding AllowHeadless}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Enable unfocused acrylic"
                              Description="Keep the acrylic effect when the window loses focus.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Enable unfocused acrylic" IsChecked="{Binding EnableUnfocusedAcrylic}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Show input service warning"
                              Description="Warn when the text input service is unavailable.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Show input service warning" IsChecked="{Binding InputServiceWarning}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ExtensionsSettingsViewModel}" x:DataType="vm:ExtensionsSettingsViewModel">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="pageDescription" Text="{Binding Description}" />
        <Border Classes="settings-card">
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="fieldLabel" Text="Language" />
          <TextBox Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding Language}" />
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Web search query URL" />
          <TextBox Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding SearchWebDefaultQueryUrl}" />
          <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Disabled profile sources (one per line)" />
          <TextBox Grid.Row="2" Grid.Column="1" Classes="field" AcceptsReturn="True" MinHeight="90" Text="{Binding DisabledProfileSources}" />
          <TextBlock Grid.Row="3" Classes="fieldLabel" Text="Safe URI schemes (one per line)" />
          <TextBox Grid.Row="3" Grid.Column="1" Classes="field" AcceptsReturn="True" MinHeight="90" Text="{Binding SafeUriSchemes}" />
          </Grid>
        </Border>
        <controls:SettingsRow Header="Debug features"
                              Description="Expose developer-only menus and diagnostics.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Debug features" IsChecked="{Binding DebugFeaturesEnabled}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Always show notification icon"
                              Description="Keep the tray icon visible even when windows are open.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Always show notification icon" IsChecked="{Binding AlwaysShowNotificationIcon}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Minimize to notification area"
                              Description="Minimize windows to the tray instead of the taskbar.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Minimize to notification area" IsChecked="{Binding MinimizeToNotificationArea}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Show admin shield"
                              Description="Badge elevated terminal windows with a shield icon.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Show admin shield" IsChecked="{Binding ShowAdminShield}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Enable color selection"
                              Description="Allow selecting text and picking its color in the terminal.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Enable color selection" IsChecked="{Binding EnableColorSelection}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
        <controls:SettingsRow Header="Enable shell completion menu"
                              Description="Render shell-provided completion menus inside the terminal.">
          <controls:SettingsRow.Value>
            <controls:SettingsToggle AutomationProperties.Name="Enable shell completion menu" IsChecked="{Binding EnableShellCompletionMenu}" />
          </controls:SettingsRow.Value>
        </controls:SettingsRow>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel Background="{DynamicResource SettingsPageBackground}">
    <Border DockPanel.Dock="Bottom" Classes="settings-footer" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Classes="settings-ghost"
                Command="{Binding OpenJsonCommand}"
                AutomationProperties.Name="Open JSON file">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="&#xE713;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="16"
                       VerticalAlignment="Center" />
            <TextBlock Text="Open JSON file" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1"
                   Margin="16,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource SettingsTextSecondary}"
                   ToolTip.Tip="{Binding StatusMessage}"
                   Text="{Binding StatusMessage}" />
        <Button Grid.Column="2"
                Classes="accent settings-save"
                Content="Save"
                Command="{Binding ApplyCommand}" />
        <Button Grid.Column="3"
                Classes="settings-secondary"
                Content="Discard changes"
                Command="{Binding RevertCommand}" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="320,*">
      <Border Grid.Column="0" Classes="settings-navigation" Padding="4,4,4,8">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel>
            <ToggleButton Name="NavigationMenuButton"
                          Classes="navigationMenu"
                          AutomationProperties.Name="Search settings"
                          IsChecked="{Binding IsSearchOpen}">
              <TextBlock Text="&#xE700;"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         FontSize="16" />
            </ToggleButton>
            <TextBox Margin="4,0,4,8"
                     IsVisible="{Binding IsSearchOpen}"
                     PlaceholderText="Search settings"
                     Text="{Binding SearchText}" />
          </StackPanel>
          <ListBox Grid.Row="1"
                   Classes="settings-navigation-list"
                   ItemsSource="{Binding VisibleNavigationItems}"
                   SelectedItem="{Binding SelectedNavigationItem}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsNavigationItem">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="32,*" ColumnSpacing="8">
                  <TextBlock Grid.ColumnSpan="2"
                             Margin="11,12,0,6"
                             FontSize="13"
                             Foreground="{DynamicResource SettingsTextSecondary}"
                             IsVisible="{Binding HasGroupHeader}"
                             Text="{Binding GroupHeader}" />
                  <TextBlock Text="{Binding Icon}"
                             Grid.Row="1"
                             FontFamily="{Binding IconFontFamily}"
                             FontSize="16"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding Title}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="2"
                  Background="{DynamicResource SettingsNavigationBackground}"
                  Padding="0,8,0,0">
            <Button Classes="settings-ghost"
                    HorizontalAlignment="Left"
                    Command="{Binding AddProfileCommand}"
                    AutomationProperties.Name="Add a new profile">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xE710;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16"
                           VerticalAlignment="Center" />
                <TextBlock Text="Add a new profile" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Border>
        </Grid>
      </Border>

      <DockPanel Grid.Column="1">
        <ScrollViewer Padding="16,4,16,24" HorizontalScrollBarVisibility="Disabled">
          <ContentControl Content="{Binding CurrentPage}" />
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
