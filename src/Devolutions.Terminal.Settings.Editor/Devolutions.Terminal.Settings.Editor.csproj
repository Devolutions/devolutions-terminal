<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Devolutions.Terminal.Settings.Editor</RootNamespace>
    <AssemblyName>Devolutions.Terminal.Settings.Editor</AssemblyName>
    <Description>Avalonia settings editor for Devolutions Terminal.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devolutions.Terminal.Settings\Devolutions.Terminal.Settings.csproj" />
    <AvaloniaResource Include="..\..\assets\profile-icons\iseberg.scale-100.png" Link="Assets\iseberg.scale-100.png" />
  </ItemGroup>
</Project>
