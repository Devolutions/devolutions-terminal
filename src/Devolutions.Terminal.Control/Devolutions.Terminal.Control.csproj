<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Devolutions.Terminal</RootNamespace>
    <Description>Avalonia terminal control that renders Devolutions.Terminal.Core.</Description>

    <PackageId>Devolutions.Terminal.Control</PackageId>
    <PackageTags>avalonia;terminal;console;vt100;ansi;pty;conpty;xterm</PackageTags>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Devolutions/devolutions-terminal</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <!--
      Genuine third-party dependencies pulled in transitively via the
      internal Devolutions.Terminal.Render reference below. PrivateAssets on
      that ProjectReference prevents its own PackageReferences from flowing
      into this package's nuspec automatically, so they are declared here
      directly to keep this package's dependency list complete/correct.
    -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" GeneratePathProperty="true" ExcludeAssets="build" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Core/Render/Connection/Settings are internal (IsPackable=false) and are
      bundled directly into this package's lib folder below rather than
      published as separate NuGet packages. PrivateAssets="all" keeps them
      out of this package's dependency list in the nuspec (otherwise NuGet
      would emit dangling dependencies on packages that are never published).
      This also means other in-repo projects can no longer rely on Control to
      transitively expose these assemblies at compile time — any project
      that uses their types directly must reference them directly.
    -->
    <ProjectReference Include="..\Devolutions.Terminal.Core\Devolutions.Terminal.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Devolutions.Terminal.Render\Devolutions.Terminal.Render.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Devolutions.Terminal.Connection\Devolutions.Terminal.Connection.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Devolutions.Terminal.Settings\Devolutions.Terminal.Settings.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\fonts\CascadiaMono.ttf"
                      Link="Assets\Fonts\CascadiaMono.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\CascadiaMonoItalic.ttf"
                      Link="Assets\Fonts\CascadiaMonoItalic.ttf" />
    <AvaloniaResource Include="..\..\native\noto-emoji\NotoColorEmoji.ttf"
                      Link="Assets\Fonts\NotoColorEmoji.ttf" />
  </ItemGroup>
  <Import Project="..\..\native\noto-emoji\NotoEmoji.targets" />
  <ItemGroup>
    <None Remove="buildTransitive\**" />
    <None Include="buildTransitive\*.targets" Pack="true" PackagePath="buildTransitive" />
    <None Include="..\Devolutions.Terminal.Connection\ConPtyHost.targets"
          Pack="true" PackagePath="buildTransitive" />
    <None Include="..\Devolutions.Terminal.Connection\THIRD-PARTY-NOTICES-CONPTY.txt"
          Pack="true" PackagePath="buildTransitive" />
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\**\OpenConsole.exe"
          Pack="true" PackagePath="tools\conpty" />
  </ItemGroup>

  <!--
    The Unix PTY host is a native executable, so it ships as a runtimes/<rid>/native asset
    for every Unix RID LinuxPtyConnection supports. Linux hosts cross-compile with Zig on
    any OS, but macOS hosts need Apple clang, so a pack on one machine normally has only
    some of them; CI collects all four and passes RequireUnixPtyHosts=true.
  -->
  <PropertyGroup>
    <UnixPtyHostRoot Condition="'$(UnixPtyHostRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\native\linux-pty'))</UnixPtyHostRoot>
  </PropertyGroup>
  <ItemGroup>
    <UnixPtyHostRid Include="linux-x64;linux-arm64;osx-x64;osx-arm64" />
    <None Include="$(UnixPtyHostRoot)\linux-x64\dt-pty-host" Condition="Exists('$(UnixPtyHostRoot)\linux-x64\dt-pty-host')"
          Pack="true" PackagePath="runtimes\linux-x64\native" Visible="false" />
    <None Include="$(UnixPtyHostRoot)\linux-arm64\dt-pty-host" Condition="Exists('$(UnixPtyHostRoot)\linux-arm64\dt-pty-host')"
          Pack="true" PackagePath="runtimes\linux-arm64\native" Visible="false" />
    <None Include="$(UnixPtyHostRoot)\osx-x64\dt-pty-host" Condition="Exists('$(UnixPtyHostRoot)\osx-x64\dt-pty-host')"
          Pack="true" PackagePath="runtimes\osx-x64\native" Visible="false" />
    <None Include="$(UnixPtyHostRoot)\osx-arm64\dt-pty-host" Condition="Exists('$(UnixPtyHostRoot)\osx-arm64\dt-pty-host')"
          Pack="true" PackagePath="runtimes\osx-arm64\native" Visible="false" />
  </ItemGroup>
  <Target Name="CheckUnixPtyHostsForPack" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_MissingUnixPtyHost Include="@(UnixPtyHostRid)" Condition="!Exists('$(UnixPtyHostRoot)\%(Identity)\dt-pty-host')" />
    </ItemGroup>
    <Error Condition="'$(RequireUnixPtyHosts)' == 'true' and '@(_MissingUnixPtyHost)' != ''"
           Text="dt-pty-host is missing for @(_MissingUnixPtyHost->'%(Identity)', ', ') under $(UnixPtyHostRoot). Build it with native/linux-pty/Build-LinuxPtyHost.ps1." />
    <Message Condition="'$(RequireUnixPtyHosts)' != 'true' and '@(_MissingUnixPtyHost)' != ''" Importance="high"
             Text="Packing Devolutions.Terminal.Control without dt-pty-host for @(_MissingUnixPtyHost->'%(Identity)', ', '); local shells will not start on those platforms." />
  </Target>

  <!--
    Bundle the build outputs of the internal, non-packable project
    references (Core/Render/Connection/Settings) directly into this
    package's lib\<tfm> folder, so consumers get one self-contained
    Devolutions.Terminal.Control package instead of a chain of internal
    package dependencies. Genuine third-party dependencies (Avalonia,
    SkiaSharp, HarfBuzzSharp, native runtime assets) are unaffected and
    continue to flow through as normal transitive PackageReferences.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>
</Project>
