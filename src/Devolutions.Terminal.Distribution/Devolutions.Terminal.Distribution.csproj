<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeSymbols>false</IncludeSymbols>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dt</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;any</RuntimeIdentifiers>
    <RollForward>Major</RollForward>
    <PackageId>Devolutions.Terminal.App</PackageId>
    <PackageTitle>Devolutions Terminal application</PackageTitle>
    <Description>RID-specific .NET tool packages for the NativeAOT Devolutions Terminal application.</Description>
    <PackageTags>Devolutions;Terminal;Windows;Linux;macOS;NativeAOT;dt</PackageTags>
    <Authors>Devolutions Inc.</Authors>
    <Company>Devolutions Inc.</Company>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <DevolutionsTerminalNugetLayoutRoot Condition="'$(DevolutionsTerminalNugetLayoutRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout</DevolutionsTerminalNugetLayoutRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">
    <None Include="$(DevolutionsTerminalNugetLayoutRoot)\$(RuntimeIdentifier)\**\*"
          Pack="true"
          PackagePath="tools\net10.0\$(RuntimeIdentifier)\payload"
          Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'any'">
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <Target Name="ValidateDevolutionsTerminalToolLayout"
          BeforeTargets="GenerateNuspec"
          Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">
    <PropertyGroup>
      <_DevolutionsTerminalExecutableName Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">dt.exe</_DevolutionsTerminalExecutableName>
      <_DevolutionsTerminalExecutableName Condition="'$(_DevolutionsTerminalExecutableName)' == ''">dt</_DevolutionsTerminalExecutableName>
      <_DevolutionsTerminalHostName Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">Devolutions.Terminal.exe</_DevolutionsTerminalHostName>
      <_DevolutionsTerminalHostName Condition="'$(_DevolutionsTerminalHostName)' == ''">Devolutions.Terminal</_DevolutionsTerminalHostName>
      <_DevolutionsTerminalRuntimeLayout>$(DevolutionsTerminalNugetLayoutRoot)\$(RuntimeIdentifier)</_DevolutionsTerminalRuntimeLayout>
    </PropertyGroup>

    <Error Condition="!Exists('$(_DevolutionsTerminalRuntimeLayout)\$(_DevolutionsTerminalExecutableName)')"
           Text="Missing staged dt executable for RuntimeIdentifier '$(RuntimeIdentifier)': $(_DevolutionsTerminalRuntimeLayout)\$(_DevolutionsTerminalExecutableName)" />
    <Error Condition="!Exists('$(_DevolutionsTerminalRuntimeLayout)\$(_DevolutionsTerminalHostName)')"
           Text="Missing staged Devolutions Terminal host for RuntimeIdentifier '$(RuntimeIdentifier)': $(_DevolutionsTerminalRuntimeLayout)\$(_DevolutionsTerminalHostName)" />
  </Target>
</Project>
