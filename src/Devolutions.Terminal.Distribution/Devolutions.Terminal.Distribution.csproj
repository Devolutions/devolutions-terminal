<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking Condition="'$(DevolutionsTerminalPackageRuntimeIdentifier)' != ''">true</SuppressDependenciesWhenPacking>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <PackageId Condition="'$(DevolutionsTerminalPackageRuntimeIdentifier)' == ''">Devolutions.Terminal.App</PackageId>
    <PackageId Condition="'$(DevolutionsTerminalPackageRuntimeIdentifier)' != ''">Devolutions.Terminal.App.$(DevolutionsTerminalPackageRuntimeIdentifier)</PackageId>
    <PackageTitle>Devolutions Terminal application</PackageTitle>
    <Description>Standalone NativeAOT Devolutions Terminal distributions for Windows, Linux, and macOS.</Description>
    <PackageTags>Devolutions;Terminal;Windows;Linux;macOS;NativeAOT;dt</PackageTags>
    <Authors>Devolutions Inc.</Authors>
    <Company>Devolutions Inc.</Company>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <DevolutionsTerminalNugetLayoutRoot Condition="'$(DevolutionsTerminalNugetLayoutRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout</DevolutionsTerminalNugetLayoutRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(DevolutionsTerminalPackageRuntimeIdentifier)' == ''">
    <PackageReference Include="Devolutions.Terminal.App.win-x64" VersionOverride="[$(PackageVersion)]" ExcludeAssets="compile" PrivateAssets="none" />
    <PackageReference Include="Devolutions.Terminal.App.win-arm64" VersionOverride="[$(PackageVersion)]" ExcludeAssets="compile" PrivateAssets="none" />
    <PackageReference Include="Devolutions.Terminal.App.linux-x64" VersionOverride="[$(PackageVersion)]" ExcludeAssets="compile" PrivateAssets="none" />
    <PackageReference Include="Devolutions.Terminal.App.linux-arm64" VersionOverride="[$(PackageVersion)]" ExcludeAssets="compile" PrivateAssets="none" />
    <PackageReference Include="Devolutions.Terminal.App.osx-x64" VersionOverride="[$(PackageVersion)]" ExcludeAssets="compile" PrivateAssets="none" />
    <PackageReference Include="Devolutions.Terminal.App.osx-arm64" VersionOverride="[$(PackageVersion)]" ExcludeAssets="compile" PrivateAssets="none" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(DevolutionsTerminalPackageRuntimeIdentifier)' != ''">
    <None Include="$(DevolutionsTerminalNugetLayoutRoot)\$(DevolutionsTerminalPackageRuntimeIdentifier)\**\*"
          Pack="true"
          PackagePath="runtimes\$(DevolutionsTerminalPackageRuntimeIdentifier)\native\payload"
          Visible="false" />
    <None Include="Devolutions.Terminal.App.targets"
          Pack="true"
          PackagePath="buildTransitive\$(PackageId).targets" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <Target Name="ValidateDevolutionsTerminalPackageLayout"
          BeforeTargets="GenerateNuspec"
          Condition="'$(DevolutionsTerminalPackageRuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_DevolutionsTerminalExecutableName Condition="$([System.String]::Copy('$(DevolutionsTerminalPackageRuntimeIdentifier)').StartsWith('win-'))">dt.exe</_DevolutionsTerminalExecutableName>
      <_DevolutionsTerminalExecutableName Condition="'$(_DevolutionsTerminalExecutableName)' == ''">dt</_DevolutionsTerminalExecutableName>
      <_DevolutionsTerminalHostName Condition="$([System.String]::Copy('$(DevolutionsTerminalPackageRuntimeIdentifier)').StartsWith('win-'))">Devolutions.Terminal.exe</_DevolutionsTerminalHostName>
      <_DevolutionsTerminalHostName Condition="'$(_DevolutionsTerminalHostName)' == ''">Devolutions.Terminal</_DevolutionsTerminalHostName>
      <_DevolutionsTerminalRuntimeLayout>$(DevolutionsTerminalNugetLayoutRoot)\$(DevolutionsTerminalPackageRuntimeIdentifier)</_DevolutionsTerminalRuntimeLayout>
    </PropertyGroup>

    <Error Condition="!Exists('$(_DevolutionsTerminalRuntimeLayout)\$(_DevolutionsTerminalExecutableName)')"
           Text="Missing staged dt executable for RuntimeIdentifier '$(DevolutionsTerminalPackageRuntimeIdentifier)': $(_DevolutionsTerminalRuntimeLayout)\$(_DevolutionsTerminalExecutableName)" />
    <Error Condition="!Exists('$(_DevolutionsTerminalRuntimeLayout)\$(_DevolutionsTerminalHostName)')"
           Text="Missing staged Devolutions Terminal host for RuntimeIdentifier '$(DevolutionsTerminalPackageRuntimeIdentifier)': $(_DevolutionsTerminalRuntimeLayout)\$(_DevolutionsTerminalHostName)" />
  </Target>
</Project>
