<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <PackageId>Devolutions.Terminal.App</PackageId>
    <PackageTitle>Devolutions Terminal application</PackageTitle>
    <Description>Standalone NativeAOT Devolutions Terminal distributions for Windows, Linux, and macOS.</Description>
    <PackageTags>Devolutions;Terminal;Windows;Linux;macOS;NativeAOT;dt</PackageTags>
    <Authors>Devolutions Inc.</Authors>
    <Company>Devolutions Inc.</Company>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\win-x64\**\*"
             Pack="true"
             PackagePath="runtimes\win-x64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\win-arm64\**\*"
             Pack="true"
             PackagePath="runtimes\win-arm64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\linux-x64\**\*"
             Exclude="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\linux-x64\dt;$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\linux-x64\Devolutions.Terminal"
             Pack="true"
             PackagePath="runtimes\linux-x64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\linux-x64\dt"
             Pack="true"
             PackagePath="runtimes\linux-x64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\linux-x64\Devolutions.Terminal"
             Pack="true"
             PackagePath="runtimes\linux-x64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\linux-arm64\**\*"
             Exclude="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\linux-arm64\dt;$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\linux-arm64\Devolutions.Terminal"
             Pack="true"
             PackagePath="runtimes\linux-arm64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\linux-arm64\dt"
             Pack="true"
             PackagePath="runtimes\linux-arm64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\linux-arm64\Devolutions.Terminal"
             Pack="true"
             PackagePath="runtimes\linux-arm64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\osx-x64\**\*"
             Exclude="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\osx-x64\dt;$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\osx-x64\Devolutions.Terminal"
             Pack="true"
             PackagePath="runtimes\osx-x64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\osx-x64\dt"
             Pack="true"
             PackagePath="runtimes\osx-x64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\osx-x64\Devolutions.Terminal"
             Pack="true"
             PackagePath="runtimes\osx-x64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\osx-arm64\**\*"
             Exclude="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\osx-arm64\dt;$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\osx-arm64\Devolutions.Terminal"
             Pack="true"
             PackagePath="runtimes\osx-arm64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\osx-arm64\dt"
             Pack="true"
             PackagePath="runtimes\osx-arm64\native\payload\" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\artifacts\nuget\layout\osx-arm64\Devolutions.Terminal"
             Pack="true"
             PackagePath="runtimes\osx-arm64\native\payload\" />
    <None Include="Devolutions.Terminal.App.targets" Pack="true" PackagePath="build\Devolutions.Terminal.App.targets" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
