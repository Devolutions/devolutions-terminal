<?xml version="1.0"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DevolutionsTerminalAppRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</DevolutionsTerminalAppRuntimeIdentifier>
    <DevolutionsTerminalAppRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == 'win-x64' OR '$(RuntimeIdentifier)' == 'win-arm64' OR '$(RuntimeIdentifier)' == 'linux-x64' OR '$(RuntimeIdentifier)' == 'linux-arm64' OR '$(RuntimeIdentifier)' == 'osx-x64' OR '$(RuntimeIdentifier)' == 'osx-arm64'">$(RuntimeIdentifier)</DevolutionsTerminalAppRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup Condition="'$(DevolutionsTerminalAppRuntimeIdentifier)' != ''">
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes\$(DevolutionsTerminalAppRuntimeIdentifier)\native\payload\**\*">
      <Link>runtimes\$(DevolutionsTerminalAppRuntimeIdentifier)\native\payload\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PublishState>Included</PublishState>
      <Visible>false</Visible>
      <Pack>false</Pack>
    </Content>
  </ItemGroup>
</Project>
